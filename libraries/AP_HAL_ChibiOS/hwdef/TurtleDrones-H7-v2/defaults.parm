#motor outputs

#
MOT_PWM_TYPE        6
#esc type BLHeli32/Kiss/AM32
SERVO_DSHOT_ESC	    1
#dshot rate 1Khz
SERVO_DSHOT_RATE	0
#enable BLHeli/AM32 pass thru
SERVO_BLH_AUTO      1
#config passthru on outputs 1-4 (group 2)
SERVO_BLH_MASK	    15
#output type Dshot600
SERVO_BLH_OTYPE	    6
#disable BD for now
SERVO_BLH_BDMASK	0
#ESC telemetry rate 10Hz
SERVO_BLH_TRATE	    10

SERVO_BLH_RVMASK	12

